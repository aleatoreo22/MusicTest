# 🎵 Music Backend Configuration

# ===== DATABASE =====
# SQLite (padrão) - arquivo será criado automaticamente
# Para PostgreSQL, use: postgres://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:music.db

# ===== SERVER =====
# Porta do servidor
PORT=8080

# ===== JWT =====
# Chave secreta para assinar tokens JWT
# Gere uma com: openssl rand -base64 32
JWT_SECRET=sua_chave_secreta_super_segura_aqui

# ===== SPOTIFY OAUTH2 =====
# Credentials para OAuth2 do Spotify
# Registre em: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui

# URL de callback após autorização do Spotify
# Deve ser a mesma registrada em https://developer.spotify.com/dashboard
SPOTIFY_REDIRECT_URL=http://localhost:8080/api/v1/auth/spotify/callback

# ===== SOUNDCLOUD OAUTH2 (client_credentials) =====
# Cadastre um app em https://soundcloud.com/you/apps para obter client_id/secret
# Usado para busca e resolução de URLs de streaming (HLS/AAC)
SOUNDCLOUD_CLIENT_ID=seu_client_id_aqui
SOUNDCLOUD_CLIENT_SECRET=seu_client_secret_aqui

# ===== LOGGING =====
# Nivel de log (debug, info, warn, error)
LOG_LEVEL=info

# ===== ENVIRONMENT =====
# Ambiente (development, staging, production)
ENV=development
